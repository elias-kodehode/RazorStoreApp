@page "/dashboard/products/edit/{id:int}"

@model RazorShoppingApp.Pages.Dashboard.Products.EditModel

<form method="post" id="editForm">
    <div class="form-group">
        <label asp-for="Input.Name"></label>
        <input class="form-control" asp-for="Input.Name" />
    </div>
    <div class="form-group">
        <label asp-for="Input.Description"></label>
        <input class="form-control" asp-for="Input.Description" />
    </div>
    <div class="form-group">
        <label asp-for="Input.Price"></label>
        <input type="number" class="form-control" asp-for="Input.Price" />
    </div>
    <div class="form-group">
        <label asp-for="Input.ImageUrl"></label>
        <input type="file" class="form-control" asp-for="Input.ImageUrl" />
    </div>


</form>

<div class="d-flex gap-2 mt-3">
    <button type="submit" form="editForm" class="btn btn-primary">Save</button>
    <a asp-page="/dashboard" class="btn btn-secondary">Cancel</a>
    <form method="post"
          asp-page-handler="Delete" onsubmit="return confirm('Are you sure?');">
        <button class="btn btn-danger">Delete</button>
    </form>
</div>