@page "/Todos"
@model RazorShoppingApp.Pages.TodosModel



<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var todo in Model.Todos)
        {
            <tr>
                <form method="post" asp-page-handler="Update" asp-route-id="@todo.Id">
                    <td>@todo.Id</td>
                    <td>
                        <input class="form-control"  name="Title" value="@todo.Title"/>
                    </td>
                    <td>
                        <textarea name="Description"  class="form-control description-input" rows="4">@todo.Description</textarea>
                    </td>
                    <td>
                        <input type="checkbox"
                               name="IsCompleted"
                               value="true"
                               checked="@todo.IsCompleted" />
                        <input type="hidden" name="IsCompleted" value="false" />
                    </td>
                    <td>
                        <button type="submit" class="btn btn-success">
                            Save
                        </button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>

<form>
    <button class="btn btn-primary">Add New Todo</button>
</form>